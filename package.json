{
  "name": "workflow-repo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npx tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "prepare": "husky install",
    "build": "npx tailwindcss -i ./css/input.css -o ./css/style.css --minify",
    "start": "live-server --port=5500",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test:unit": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:head": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "dotenv": "^17.2.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.0",
    "live-server": "^1.2.2",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.12",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,css,html,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --cache --fix"
    ]
  }
}
